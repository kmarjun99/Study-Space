# ─────────────────────────────────────────────────────────────────────────────
# GCP Cloud Run environment variables for Study Space backend
#
# All secrets below are stored in GCP Secret Manager and injected by Cloud Run.
# You do NOT need this file on the server. Use it as a reference when running
# the deploy-gcp.sh script or when configuring the Cloud Build trigger.
#
# To set a secret manually:
#   echo -n "value" | gcloud secrets create SECRET_NAME --data-file=-
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (injected from Secret Manager) ──────────────────────────────────
# Cloud SQL Proxy socket path format for Cloud Run:
DATABASE_URL=postgresql+asyncpg://appuser:<password>/<dbname>?host=/cloudsql/<project>:<region>:<instance>

# ─── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=<generate with: python3 -c "import secrets; print(secrets.token_hex(32))">
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Deployment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production

# Comma-separated list of allowed frontend origins (Cloud Run URLs + custom domain)
CORS_ORIGINS=https://study-space-frontend-xxxx-em.a.run.app,https://studyspaceapp.in,https://www.studyspaceapp.in

# ─── Email (choose one: SendGrid or SMTP) ─────────────────────────────────────
sendgrid_api_key=SG.xxxxxxxxxx

# SMTP alternative (Gmail app password)
mail_username=you@gmail.com
mail_password=<gmail-app-password>
mail_from=noreply@studyspaceapp.in
mail_port=587
mail_server=smtp.gmail.com

# ─── Payments ─────────────────────────────────────────────────────────────────
razorpay_key_id=rzp_live_xxxxxxxxxxxx
razorpay_key_secret=<secret>
payment_demo_mode=false

# ─── Cloud SQL (set via --add-cloudsql-instances flag, not env var) ───────────
# Cloud Run connection name: project:region:instance
# Example: study-space-prod:asia-south1:study-space-db
