# ─────────────────────────────────────────────────────────────────────────────
# Frontend production environment variables for Study Space
#
# These are baked into the static JS bundle at Docker build time.
# Pass them as --build-arg to `docker build` or set them in cloudbuild.yaml
# substitutions (_VITE_API_URL, _MAPS_KEY, _GEMINI_KEY).
#
# Do NOT store secrets here — use GCP Secret Manager + Cloud Build substitutions.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (Cloud Run service URL or custom domain)
VITE_API_BASE_URL=https://api.studyspaceapp.in

# Google Maps JavaScript API key (restrict to your domain in GCP Console)
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...

# Gemini API key (loaded by vite.config.ts as process.env.API_KEY)
GEMINI_API_KEY=AIzaSy...

# Optional feature flags
VITE_ENVIRONMENT=production
VITE_API_VERSION=v1
